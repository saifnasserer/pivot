rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile images: authenticated users can read/write
    match /profile_images/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // User uploads: authenticated users can read/write their own files
    match /user_uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Announcements images: 
    // - Professors/miniProfessors can write if for their subject
    // - Admins/Super Admins can write all
    // - Anyone can read
    match /announcements/{subjectId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.role in ['Admin', 'Super Admin','Professor', 'miniProfessor']
      );
    }

    // Feedback files: authenticated users can read/write
    match /feedback/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // General uploads: authenticated users can read/write
    match /general/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Tasks: authenticated users can read/write
    match /tasks/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Guides: authenticated users can read/write
    match /guides/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
} 