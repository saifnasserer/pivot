# Use official Node.js image that includes Firebase CLI
FROM node:18-bullseye

# Install Python and required tools
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install Firebase CLI globally
RUN npm install -g firebase-tools

# Set working directory
WORKDIR /app

# Copy project files
COPY . .

# Set up Python virtual environment for functions
WORKDIR /app/functions

# Create a simplified requirements.txt for Docker deployment
RUN echo "functions-framework" > requirements.docker.txt && \
    echo "firebase-admin>=6.0.0" >> requirements.docker.txt && \
    echo "flask" >> requirements.docker.txt && \
    echo "requests" >> requirements.docker.txt && \
    echo "flask-cors" >> requirements.docker.txt

# Create virtual environment and install packages
RUN python3 -m venv venv
RUN . venv/bin/activate && pip install --upgrade pip
RUN . venv/bin/activate && pip install -r requirements.docker.txt

# Go back to project root
WORKDIR /app

# Set Firebase token as environment variable (will be provided at runtime)
# Run firebase deploy command
CMD ["sh", "-c", "cd functions && . venv/bin/activate && cd .. && firebase deploy --only functions --token $FIREBASE_TOKEN"] 