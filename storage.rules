rules_version = '2';

// Firebase Storage Rules based on Database Usage Phases
service firebase.storage {
  match /b/{bucket}/o {
    
    // ===== Helper Functions =====
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function hasRole(roles) {
      return isSignedIn() && (
        request.auth.token.role in roles ||
        // Note: We can't access Firestore from Storage rules, so we rely on token claims
        request.auth.token.role in roles
      );
    }
    
    function isAdmin() {
      return hasRole(['Admin', 'Super Admin']);
    }
    
    function isProfessor() {
      return hasRole(['Professor', 'miniProfessor', 'Admin', 'Super Admin']);
    }
    
    function isSuperAdmin() {
      return hasRole(['Super Admin']);
    }
    
    function isOwnerOrAdmin(userId) {
      return isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );
    }
    
    function isValidImageType() {
      return resource.contentType.matches('image/.*');
    }
    
    function isValidVideoType() {
      return resource.contentType.matches('video/.*');
    }
    
    function isValidPdfType() {
      return resource.contentType == 'application/pdf';
    }
    
    function isValidDocumentType() {
      return resource.contentType in [
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'text/plain'
      ];
    }
    
    function isValidAudioType() {
      return resource.contentType.matches('audio/.*');
    }
    
    function isWithinSizeLimit(maxSizeBytes) {
      return resource.size <= maxSizeBytes;
    }
    
    // ===== PHASE 1: AUTH - User Profile Images =====
    match /users/{userId}/profile/{fileName} {
      // Allow read for authenticated users
      allow read: if isSignedIn();
      
      // Allow write for user's own profile or admin
      allow write: if isOwnerOrAdmin(userId) && 
        isValidImageType() && 
        isWithinSizeLimit(5 * 1024 * 1024); // 5MB limit
      
      // Allow delete for user or admin
      allow delete: if isOwnerOrAdmin(userId);
    }
    
    // ===== PHASE 4: PROFILE - User Files and Images =====
    match /users/{userId}/files/{fileName} {
      allow read, write, delete: if isUser(userId) && 
        isValidDocumentType() && 
        isWithinSizeLimit(10 * 1024 * 1024); // 10MB limit
    }
    
    match /users/{userId}/images/{fileName} {
      allow read, write, delete: if isUser(userId) && 
        isValidImageType() && 
        isWithinSizeLimit(5 * 1024 * 1024); // 5MB limit
    }
    
    match /users/{userId}/documents/{fileName} {
      allow read, write, delete: if isUser(userId) && 
        isValidDocumentType() && 
        isWithinSizeLimit(20 * 1024 * 1024); // 20MB limit
    }
    
    // ===== PHASE 7: FEEDBACK - Feedback Images =====
    match /feedback/{feedbackId}/images/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && 
        isValidImageType() && 
        isWithinSizeLimit(5 * 1024 * 1024); // 5MB limit
      allow delete: if isAdmin();
    }
    
    // ===== PHASE 9: MEDIA - Lectures, PDFs, Videos =====
    match /lectures/{lectureId}/materials/{fileName} {
      allow read: if isSignedIn();
      allow write: if isProfessor() && (
        (isValidPdfType() && isWithinSizeLimit(50 * 1024 * 1024)) || // 50MB for PDFs
        (isValidVideoType() && isWithinSizeLimit(200 * 1024 * 1024)) || // 200MB for videos
        (isValidImageType() && isWithinSizeLimit(10 * 1024 * 1024)) || // 10MB for images
        (isValidDocumentType() && isWithinSizeLimit(20 * 1024 * 1024)) // 20MB for documents
      );
      allow delete: if isProfessor();
    }
    
    match /lectures/{lectureId}/thumbnails/{fileName} {
      allow read: if isSignedIn();
      allow write: if isProfessor() && 
        isValidImageType() && 
        isWithinSizeLimit(2 * 1024 * 1024); // 2MB limit for thumbnails
      allow delete: if isProfessor();
    }
    
    // ===== PHASE 10: TEAMS - Team Member Files =====
    match /teams/{teamId}/files/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && 
        isValidDocumentType() && 
        isWithinSizeLimit(10 * 1024 * 1024); // 10MB limit
      allow delete: if isAdmin();
    }
    
    match /teams/{teamId}/images/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && 
        isValidImageType() && 
        isWithinSizeLimit(5 * 1024 * 1024); // 5MB limit
      allow delete: if isAdmin();
    }
    
    // ===== PHASE 11: USER CONTENT - Personal Files =====
    match /users/{userId}/personal/{fileName} {
      allow read, write, delete: if isUser(userId) && 
        (isValidDocumentType() || isValidImageType() || isValidAudioType()) && 
        isWithinSizeLimit(15 * 1024 * 1024); // 15MB limit
    }
    
    match /users/{userId}/bookmarks/{fileName} {
      allow read, write, delete: if isUser(userId) && 
        isValidDocumentType() && 
        isWithinSizeLimit(10 * 1024 * 1024); // 10MB limit
    }
    
    // ===== ANNOUNCEMENTS - Announcement Attachments =====
    match /announcements/{announcementId}/attachments/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && 
        (isValidDocumentType() || isValidImageType()) && 
        isWithinSizeLimit(10 * 1024 * 1024); // 10MB limit
      allow delete: if isAdmin();
    }
    
    // ===== SUBJECTS - Subject Materials =====
    match /subjects/{subjectId}/materials/{fileName} {
      allow read: if isSignedIn();
      allow write: if isProfessor() && (
        (isValidPdfType() && isWithinSizeLimit(30 * 1024 * 1024)) || // 30MB for PDFs
        (isValidVideoType() && isWithinSizeLimit(100 * 1024 * 1024)) || // 100MB for videos
        (isValidImageType() && isWithinSizeLimit(5 * 1024 * 1024)) || // 5MB for images
        (isValidDocumentType() && isWithinSizeLimit(15 * 1024 * 1024)) // 15MB for documents
      );
      allow delete: if isProfessor();
    }
    
    // ===== TASKS - Task Attachments =====
    match /tasks/{taskId}/attachments/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && 
        (isValidDocumentType() || isValidImageType()) && 
        isWithinSizeLimit(10 * 1024 * 1024); // 10MB limit
      allow delete: if isSignedIn();
    }
    
    // ===== REPORTS - Report Attachments =====
    match /reports/{reportId}/attachments/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && 
        (isValidDocumentType() || isValidImageType()) && 
        isWithinSizeLimit(10 * 1024 * 1024); // 10MB limit
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.metadata.userId || isAdmin()
      );
    }
    
    // ===== SYSTEM FILES - Admin Only =====
    match /system/{fileName} {
      allow read, write, delete: if isAdmin();
    }
    
    match /system/logs/{fileName} {
      allow read, write, delete: if isAdmin();
    }
    
    match /system/backups/{fileName} {
      allow read, write, delete: if isSuperAdmin();
    }
    
    // ===== CACHE FILES - Temporary Storage =====
    match /cache/{userId}/{fileName} {
      allow read, write, delete: if isUser(userId);
    }
    
    // ===== TEMP FILES - Temporary Uploads =====
    match /temp/{userId}/{fileName} {
      allow read, write, delete: if isUser(userId);
    }
    
    // ===== PUBLIC ASSETS - App Assets =====
    match /public/{fileName} {
      allow read: if true; // Public read access
      allow write, delete: if isAdmin();
    }
    
    match /public/images/{fileName} {
      allow read: if true; // Public read access
      allow write, delete: if isAdmin() && 
        isValidImageType() && 
        isWithinSizeLimit(2 * 1024 * 1024); // 2MB limit
    }
    
    // ===== DEFAULT DENY =====
    match /{allPaths=**} {
      allow read, write, delete: if false;
    }
  }
}


