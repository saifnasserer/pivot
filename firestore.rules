rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helper Functions =====
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(roles) {
      return isSignedIn() &&
        (
          request.auth.token.role in roles ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles
        );
    }

    function isAdmin() {
      return hasRole(['Admin', 'Super Admin']);
    }

    function isProfessor() {
      return hasRole(['Professor', 'miniProfessor', 'Admin', 'Super Admin']);
    }

    function isSuperAdmin() {
      return hasRole(['Super Admin']);
    }

    function isInTargetList(targetList) {
      return isSignedIn() && (
        request.auth.uid in targetList || isAdmin()
      );
    }

    function canPerformAdminOperations() {
      return isAdmin();
    }

    function isOwnerOrAdmin(userId) {
      return isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );
    }

    function isTargetUserOrAdmin(targetUserIds) {
      return isSignedIn() && (
        request.auth.uid in targetUserIds || isAdmin()
      );
    }

    // ===== PHASE 1: AUTH (Login/Registration) =====
    match /users/{userId} {
      // Allow read for authenticated users
      allow read: if isSignedIn();
      
      // Allow create for new user registration
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Allow update for user's own profile or admin operations
      allow update: if isOwnerOrAdmin(userId);
      
      // Allow delete for user's own profile or admins (account deletion)
      allow delete: if isOwnerOrAdmin(userId);
      
      // Allow list for admin operations
      allow list: if canPerformAdminOperations();

      // ===== PHASE 4: PROFILE SUB-COLLECTIONS =====
      match /tasks/{taskId} {
        allow read, write: if isUser(userId);
      }

      match /schedule/{scheduleId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, write: if isUser(userId);
      }
    }

    // ===== PHASE 5: SUBJECTS =====
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ===== PHASE 6: ADMINISTRATION =====
    match /sections/{sectionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ===== PHASE 7: NOTIFICATIONS & FEEDBACK =====
    match /scheduledNotifications/{notificationId} {
      // Allow read for target users and admins
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.targetUserIds ||
        isAdmin()
      );
      
      // Allow write for admins and system updates
      allow write: if isSignedIn() && (
        isAdmin() ||
        // Allow system to update notification status
        (resource != null && resource.data.status in ['pending', 'sent', 'failed'])
      );
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ===== PHASE 8: SUPER ADMIN & ANALYTICS =====
    // Analytics data is read-only for admins and super admins
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ===== PHASE 9: MEDIA (PDF/Video & Materials) =====
    match /lectures/{lectureId} {
      allow read: if isSignedIn();
      allow write: if isProfessor();
    }

    // ===== PHASE 10: TEAMS & TASKS =====
    match /team_members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Global tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == request.resource.data.userId ||
        isAdmin()
      );
      // Allow users to delete their own tasks and list them (for account deletion)
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      allow list: if isSignedIn() || canPerformAdminOperations();
    }

    // ===== PHASE 11: SETTINGS, BOOKMARKS, SCHEDULE, NOTIFICATIONS =====
    match /user_settings/{settingId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == request.resource.data.userId ||
        isAdmin()
      );
      // Allow users to delete their own settings (for account deletion)
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      allow list: if isSignedIn() || canPerformAdminOperations();
    }

    // Global schedules collection (one document per user)
    match /schedules/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    

    // ===== ANNOUNCEMENTS =====
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read, create: if isSignedIn();
        allow update, delete: if isSignedIn() && (
          request.auth.uid == resource.data.userId ||
          isAdmin()
        );
      }
    }

    // ===== GUIDE CONTENT =====
    match /guide_content/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ===== SETTINGS =====
    match /settings/{docId} {
      allow read: if true; // Public read access
      allow write: if isAdmin();
    }

    // ===== FCM TOKENS =====
    match /fcm_tokens/{tokenId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == request.resource.data.userId ||
        isAdmin()
      );
      allow list: if canPerformAdminOperations();
    }

    // ===== REPORTS =====
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.reporterId ||
        isAdmin()
      );
      // Allow users to list their own reports (for account deletion)
      allow list: if isSignedIn() || canPerformAdminOperations();
    }

    // ===== BLOCKED USERS =====
    match /blocked_users/{blockId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.blockedUserId ||
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.blockedUserId ||
        isAdmin()
      );
      allow list: if canPerformAdminOperations();
    }

    // ===== POSTS =====
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.authorId ||
        isAdmin()
      );
      // Allow users to list their own posts (for account deletion)
      allow list: if isSignedIn() || canPerformAdminOperations();

      match /comments/{commentId} {
        allow read, create: if isSignedIn();
        allow update, delete: if isSignedIn() && (
          request.auth.uid == resource.data.userId ||
          isAdmin()
        );
        allow list: if canPerformAdminOperations();
      }

      match /likes/{likeId} {
        allow read, create, delete: if isSignedIn();
        allow update: if false;
        allow list: if canPerformAdminOperations();
      }
    }

    // ===== COMMENTS (Global Collection) =====
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.authorId ||
        isAdmin()
      );
      // Allow users to list their own comments (for account deletion)
      allow list: if isSignedIn() || canPerformAdminOperations();
    }

    // ===== NOTIFICATIONS =====
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      // Allow users to list their own notifications (for account deletion)
      allow list: if isSignedIn() || canPerformAdminOperations();
    }

    // ===== USER FILES =====
    match /user_files/{fileId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == request.resource.data.userId ||
        isAdmin()
      );
      allow list: if canPerformAdminOperations();
    }

    // ===== USER IMAGES =====
    match /user_images/{imageId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == request.resource.data.userId ||
        isAdmin()
      );
      allow list: if canPerformAdminOperations();
    }

    // ===== MEDIA COLLECTIONS =====
    match /media/{mediaId} {
      allow read: if isSignedIn();
      allow write: if isProfessor();
    }

    // ===== BOOKMARKS =====
    match /bookmarks/{bookmarkId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == request.resource.data.userId ||
        isAdmin()
      );
      allow list: if canPerformAdminOperations();
    }

    // ===== USER PREFERENCES =====
    match /user_preferences/{preferenceId} {
      allow read, write: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == request.resource.data.userId ||
        isAdmin()
      );
      allow list: if canPerformAdminOperations();
    }

    // ===== CACHE COLLECTIONS =====
    match /cache/{cacheId} {
      allow read, write: if isSignedIn();
    }

    // ===== SYSTEM LOGS =====
    match /system_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ===== AUDIT TRAILS =====
    match /audit_trails/{auditId} {
      allow read, write: if isAdmin();
    }

    // ===== SHARED SCHEDULES =====
    match /shared_schedules/{shareId} {
      // Allow read for anyone with the link (public sharing)
      allow read: if isSignedIn();
      
      // Allow create for authenticated users
      allow create: if isSignedIn();
      
      // Allow update only for the owner (for access count, expiry, etc.)
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        // Allow system to increment access count
        (request.resource.data.keys().hasAll(['accessCount']) && 
         request.resource.data.accessCount == resource.data.accessCount + 1)
      );
      
      // Allow delete only for the owner
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
      
      // Allow list only for the owner to see their shared schedules
      allow list: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    // ===== DEFAULT DENY =====
    match /{document=**} {
      allow read, write: if false;
    }

  }
}